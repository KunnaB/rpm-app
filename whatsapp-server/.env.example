# Copy to .env (setup-vm.sh does this for you). Never commit .env.
WAHA_DOMAIN=rpm-wa.duckdns.org
WAHA_IMAGE=devlikeapro/waha:latest
WAHA_API_KEY=long-random-key-goes-here
WAHA_DASHBOARD_USERNAME=rpm
WAHA_DASHBOARD_PASSWORD=strong-password-goes-here
DUCKDNS_SUBDOMAIN=rpm-wa
DUCKDNS_TOKEN=your-duckdns-token
